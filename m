>> Even the simplest use cases throw this error e.g. fs/super.c line 162-164:
>>
>> static void put_super(struct super_block *sb)
>> {
>>       spin_lock(&sb_lock);
>>       __put_super(sb);
>>       spin_unlock(&sb_lock);
